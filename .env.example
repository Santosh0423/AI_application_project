# Copy this file to .env and change values if needed. No API keys are required.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b
# For laptops with 8 GB RAM use: MODEL_NAME=llama3.2:3b
EMBED_MODEL=nomic-embed-text
REQUEST_TIMEOUT=300
LLM_TEMPERATURE=0.1

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
MIN_SIMILARITY=0.60

# Input / conversation
MAX_QUESTION_CHARS=500
HISTORY_TURNS=2

# Web server
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
